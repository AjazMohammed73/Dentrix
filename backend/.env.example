# Copy to .env and fill in. Never commit .env.

# Neon pooled connection string (the one with "-pooler" in the host).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require

# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

ACCESS_TOKEN_EXPIRE_MINUTES=720
ENV=development

# Comma-separated. Add your Vercel domain(s) before going live.
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Used once by `python -m app.seed` to create the first Super Admin.
BOOTSTRAP_SUPERADMIN_EMAIL=admin@yourclinic.io
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_SUPERADMIN_NAME=Platform Admin
